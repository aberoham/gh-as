#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
default_host=github.com
remote=${GH_AS_REMOTE:-origin}
host=${GH_HOST:-}
quiet=${GH_AS_QUIET:-}
print_only=

die() {
  printf '%s: %s\n' "$program" "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
gh-as - run a command as one of the accounts gh is logged in with, without
switching the account the rest of the machine sees.

Usage:
  gh-as <command> [args...]                account resolved from the repository
  gh-as <account> -- <command> [args...]   account named explicitly
  gh-as --print [<account>]
  gh-as --list
  gh-as --setup-git [--host HOST]          make git fetch and push resolve the
                                           same way (writes ~/.gitconfig)

Options:
  -l, --list       List the accounts logged in on the host
  -p, --print      Print the account that would be used, then exit
  -q, --quiet      Do not announce the account on stderr
      --host HOST  Host to take the account from (default: $GH_HOST, the
                   remote's host, or github.com)
      --setup-git  Install gh-as as git's credential helper for the host
  -h, --help       Show this help

Account resolution, in order:
  1. the account named on the command line
  2. git config --get-urlmatch gh-as.account <remote url>
  3. git config --get-urlmatch credential.username <remote url>
  4. the repository owner, when it is itself a logged-in account
  5. the only account logged in on the host

Environment:
  GH_AS_REMOTE  remote to resolve the account from (default: origin)
  GH_AS_QUIET   non-empty implies --quiet

The token is handed to the command as GH_TOKEN on github.com and *.ghe.com
(GH_ENTERPRISE_TOKEN for Enterprise Server), together with GH_AS_ACCOUNT and
GH_HOST. Nothing outside the process changes.

As a git credential helper (installed by --setup-git, invoked by git as
`gh-as --git-credential get`) the same resolution runs on the URL git is
about to fetch or push, so plain git picks the account per repository too.
USAGE
}

# An inherited token wins over --user and would hand back the ambient
# credential under whatever name was asked for.
gh_clean() {
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN gh "$@"
}

# `gh auth status` is the only interface that enumerates accounts: hosts.yml
# holds no tokens under a keyring setup and needs a YAML parser besides.
accounts() {
  gh_clean auth status --hostname "$1" 2>&1 |
    grep -oE 'account [^ ]+' | cut -d' ' -f2 | sort -u
}

normalize_url() {
  local url=$1 authority path
  url=${url%/}
  url=${url%.git}
  case $url in
    *://*) url=${url#*://} ;;
    *:*) url=${url/:/\/} ;;
  esac
  authority=${url%%/*}
  path=${url#*/}
  authority=${authority##*@}
  authority=${authority%%:*}
  printf 'https://%s/%s\n' "$authority" "$path"
}

url_host() {
  local rest=${1#https://}
  printf '%s\n' "${rest%%/*}"
}

# The owner segment of https://host/owner/repo, or nothing when the URL has
# no path at all, which is what git sends a credential helper when
# useHttpPath is off.
url_owner() {
  local rest=${1#https://}
  [[ $rest == */* ]] || return 0
  rest=${rest#*/}
  printf '%s\n' "${rest%%/*}"
}

# A stored token for the owner is a keyring read; enumerating accounts through
# `gh auth status` validates every token over the network. Try the cheap
# check first, since a credential helper runs on every fetch.
has_token() {
  local probe
  probe=$(gh_clean auth token --hostname "$1" --user "$2" 2>/dev/null) || return 1
  [[ -n $probe ]]
}

resolve_account() {
  local url=$1 resolved_host=$2 account owner known

  if [[ -n $url ]]; then
    account=$(git config --get-urlmatch gh-as.account "$url" 2>/dev/null) || account=
    [[ -z $account ]] || {
      printf '%s\n' "$account"
      return
    }

    account=$(git config --get-urlmatch credential.username "$url" 2>/dev/null) || account=
    [[ -z $account ]] || {
      printf '%s\n' "$account"
      return
    }

    owner=$(url_owner "$url")
    if [[ -n $owner ]] && has_token "$resolved_host" "$owner"; then
      printf '%s\n' "$owner"
      return
    fi
  fi

  known=$(accounts "$resolved_host") || known=
  [[ -n $known ]] || die "no account logged in on $resolved_host; run: gh auth login --hostname $resolved_host"

  if [[ $(printf '%s\n' "$known" | wc -l) -eq 1 ]]; then
    printf '%s\n' "$known"
    return
  fi

  die "cannot tell which account this repository belongs to; name one of: $(printf '%s' "$known" | tr '\n' ' ')"
}

# git credential helper protocol: key=value lines on stdin up to a blank
# line, and the same shape back on stdout. `store` and `erase` are accepted
# and ignored, as gh's own helper does, because the tokens live in gh's
# keyring and git has nothing to add or remove.
credential_helper() {
  local op=$1 line key value
  local protocol='' cred_host='' path='' username='' cred_url=''

  case $op in
    get) ;;
    store | erase) exit 0 ;;
    *) die "--git-credential: unsupported operation '$op'" ;;
  esac

  # git splits a url= into these attributes itself before calling a helper,
  # so only the split form is read here.
  while IFS= read -r line && [[ -n $line ]]; do
    key=${line%%=*}
    value=${line#*=}
    case $key in
      protocol) protocol=$value ;;
      host) cred_host=$value ;;
      path) path=${value#/} ;;
      username) username=$value ;;
    esac
  done

  if [[ -n $path ]]; then
    cred_url=$(normalize_url "https://$cred_host/$path")
  else
    cred_url=https://$cred_host
  fi

  # Anything but https is not gh's to answer; stay silent so git moves on to
  # the next helper or the terminal.
  [[ $protocol == https && -n $cred_host ]] || exit 0

  # A username git already resolved, from credential.username or a user@host
  # remote, is an instruction rather than a hint. gh's own helper refuses a
  # username that differs from the active account; this one selects by it.
  local account=$username token
  [[ -n $account ]] || account=$(resolve_account "$cred_url" "$cred_host")

  token=$(gh_clean auth token --hostname "$cred_host" --user "$account" 2>/dev/null) || token=
  [[ -n $token ]] ||
    die "no token for account '$account' on $cred_host; logged in are: $(accounts "$cred_host" | tr '\n' ' ')"

  printf 'protocol=https\nhost=%s\nusername=%s\npassword=%s\n' "$cred_host" "$account" "$token"
}

# Point git at this script for one host. The blank helper first clears any
# helper inherited from the system config (Apple's git ships osxkeychain
# there), so a stale keychain entry cannot answer ahead of gh-as; useHttpPath
# makes git hand over the repository path the resolution depends on.
setup_git() {
  local setup_host=$1 script quoted section helper
  case $0 in
    /*) script=$0 ;;
    */*) script=$PWD/${0#./} ;;
    *) script=$(command -v -- "$0") ;;
  esac
  [[ $script == /* ]] || script=$PWD/$script
  # git runs the helper through sh -c, so the path is single-quoted with any
  # embedded quote closed, escaped and reopened. sed rather than parameter
  # expansion because bash 3.2 mangles the backslashes in that expansion.
  quoted=$(printf '%s' "$script" | sed "s/'/'\\\\''/g")
  section=credential.https://$setup_host
  helper="!'$quoted' --git-credential"

  git config --global "$section.useHttpPath" true
  git config --global --replace-all "$section.helper" ''
  git config --global --add "$section.helper" "$helper"

  printf '%s: git will now resolve credentials for %s through %s\n' "$program" "$setup_host" "$script" >&2
  printf '%s: declare accounts per URL with: git config --global gh-as.https://%s/<owner>.account <login>\n' "$program" "$setup_host" >&2
  printf '  %s.useHttpPath = %s\n' "$section" "$(git config --global --get "$section.useHttpPath")" >&2
  git config --global --get-all "$section.helper" | sed "s|^|  $section.helper = |" >&2
}

has_separator() {
  local arg
  for arg in "$@"; do
    if [[ $arg == -- ]]; then
      return 0
    fi
  done
  return 1
}

account=
setup=
while [[ $# -gt 0 ]]; do
  case $1 in
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l | --list)
      accounts "${host:-$default_host}"
      exit 0
      ;;
    --git-credential)
      [[ $# -eq 2 ]] || die "--git-credential takes exactly one operation (get, store or erase)"
      credential_helper "$2"
      exit 0
      ;;
    --setup-git)
      setup=1
      shift
      ;;
    -p | --print)
      print_only=1
      shift
      ;;
    -q | --quiet)
      quiet=1
      shift
      ;;
    --host)
      [[ $# -ge 2 ]] || die "--host needs a value"
      host=$2
      shift 2
      ;;
    --host=*)
      host=${1#*=}
      shift
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      has_separator "$@" || break
      [[ -z $account ]] || die "more than one account given"
      account=$1
      shift
      ;;
  esac
done

if [[ -n $setup ]]; then
  [[ $# -eq 0 && -z $account && -z $print_only ]] || die "--setup-git takes only --host"
  setup_git "${host:-$default_host}"
  exit 0
fi

if [[ -n $print_only && -z $account && $# -eq 1 ]]; then
  account=$1
  shift
fi

url=
if remote_url=$(git remote get-url "$remote" 2>/dev/null); then
  url=$(normalize_url "$remote_url")
fi

# Off an explicit account the remote's host is not consulted: a repository
# hosted elsewhere would otherwise send the lookup to a host gh knows nothing
# about, which is only ever confusing when the account was already named.
if [[ -z $host ]]; then
  if [[ -z $account && -n $url ]]; then
    host=$(url_host "$url")
  else
    host=$default_host
  fi
fi

if [[ -z $account ]]; then
  [[ -n $url ]] || die "no '$remote' remote here; name the account explicitly (see --help)"
  account=$(resolve_account "$url" "$host")
fi

if [[ -n $print_only ]]; then
  printf '%s\n' "$account"
  exit 0
fi

[[ $# -gt 0 ]] || die "no command given (see --help)"

# `gh auth login|switch|logout` bail out with "The value of the GH_TOKEN
# environment variable is being used for authentication", so wrapping them
# would only produce a confusing failure.
if [[ ${1##*/} == gh ]]; then
  for arg in "${@:2}"; do
    case $arg in
      -*) continue ;;
      auth) die "gh auth refuses to run under an injected token; run it without $program" ;;
      *) break ;;
    esac
  done
fi

token=$(gh_clean auth token --hostname "$host" --user "$account" 2>/dev/null) || token=
[[ -n $token ]] ||
  die "no token for account '$account' on $host; logged in are: $(accounts "$host" | tr '\n' ' ')"

# Match gh's host classification, including Enterprise Cloud with data residency.
# Lowercase for comparison without requiring bash 4's case conversion syntax.
case $(printf '%s' "$host" | tr '[:upper:]' '[:lower:]') in
  github.com | *.github.com | github.localhost | *.github.localhost | *.ghe.com)
    token_var=GH_TOKEN
    ;;
  *)
    token_var=GH_ENTERPRISE_TOKEN
    ;;
esac

env_args=(-u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN)
env_args+=("$token_var=$token" "GH_AS_ACCOUNT=$account" "GH_HOST=$host")

[[ -n $quiet ]] || printf '%s: running as %s\n' "$program" "$account" >&2

# Injecting the token beats `gh auth switch`: switching rewrites
# ~/.config/gh/hosts.yml, which every shell and agent on the machine shares, so
# concurrent commands race over the active account and an interrupted one
# leaves the wrong account behind. This environment dies with the process.
exec env "${env_args[@]}" "$@"
