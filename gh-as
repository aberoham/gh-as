#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
default_host=github.com
remote=${GH_AS_REMOTE:-origin}
host=${GH_HOST:-}
quiet=${GH_AS_QUIET:-}
print_only=

die() {
  printf '%s: %s\n' "$program" "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
gh-as - run a command as one of the accounts gh is logged in with, without
switching the account the rest of the machine sees.

Usage:
  gh-as [--] <command> [args...]           account resolved from the repository
  gh-as <account> -- <command> [args...]   account named explicitly
  gh-as --print [<account>]
  gh-as --list
  gh-as --setup-git [--host HOST]          make git fetch and push resolve the
                                           same way (writes ~/.gitconfig)
  gh-as --setup-ssh [--host HOST] [<account>]
                                           fetch over SSH from every organization
                                           the account's key is authorized for
                                           (writes ~/.gitconfig; rerun freely)

Options:
  -l, --list       List the accounts logged in on the host
  -p, --print      Print the account that would be used, then exit
  -q, --quiet      Do not announce the account on stderr
      --host HOST  Host to take the account from (default: $GH_HOST, the
                   remote's host, or github.com)
      --setup-git  Install gh-as as git's credential helper for the host
      --setup-ssh  Probe each of the account's organizations over SSH and
                   rewrite https://HOST/<org>/ to SSH where the key works,
                   removing the rewrite only where GitHub refuses the key
                   for single sign-on
  -h, --help       Show this help

Account resolution, in order:
  1. the account named on the command line
  2. git config --get-urlmatch gh-as.account <remote url>
  3. git config --get-urlmatch credential.username <remote url>
  4. the repository owner, when it is itself a logged-in account
  5. the only account logged in on the host

Environment:
  GH_AS_REMOTE  remote to resolve the account from (default: origin)
  GH_AS_QUIET   non-empty implies --quiet

The token is handed to the command as GH_TOKEN on github.com and *.ghe.com
(GH_ENTERPRISE_TOKEN for Enterprise Server), together with GH_AS_ACCOUNT and
GH_HOST. Nothing outside the process changes.

As a git credential helper (installed by --setup-git, invoked by git as
`gh-as --git-credential get`) the same resolution runs on the URL git is
about to fetch or push, so plain git picks the account per repository too.
USAGE
}

# An inherited token wins over --user and would hand back the ambient
# credential under whatever name was asked for.
gh_clean() {
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN gh "$@"
}

# `gh auth status` is the only interface that enumerates accounts: hosts.yml
# holds no tokens under a keyring setup and needs a YAML parser besides.
accounts() {
  # Validation can fail while still listing stored accounts. Keep those names,
  # including failed accounts, so a failed check never makes us guess another.
  { gh_clean auth status --hostname "$1" 2>&1 || :; } |
    grep -oE 'account [^ ]+' | cut -d' ' -f2 | sort -u
}

normalize_url() {
  local url=$1 authority path
  url=${url%/}
  case $url in
    *://*) url=${url#*://} ;;
    *:*) url=${url/:/\/} ;;
  esac
  authority=${url%%/*}
  path=${url#*/}
  authority=${authority##*@}
  authority=${authority%%:*}
  printf 'https://%s/%s\n' "$authority" "$path"
}

url_host() {
  local rest=${1#https://}
  printf '%s\n' "${rest%%/*}"
}

# The owner segment of https://host/owner/repo, or nothing when the URL has
# no path at all, which is what git sends a credential helper when
# useHttpPath is off.
url_owner() {
  local rest=${1#https://}
  [[ $rest == */* ]] || return 0
  rest=${rest#*/}
  printf '%s\n' "${rest%%/*}"
}

# A stored token for the owner is a keyring read; enumerating accounts through
# `gh auth status` validates every token over the network. Try the cheap
# check first, since a credential helper runs on every fetch.
has_token() {
  local probe
  probe=$(gh_clean auth token --hostname "$1" --user "$2" 2>/dev/null) || return 1
  [[ -n $probe ]]
}

resolve_account() {
  local url=$1 resolved_host=$2 account owner known

  if [[ -n $url ]]; then
    account=$(git config --get-urlmatch gh-as.account "$url" 2>/dev/null) || account=
    [[ -z $account ]] || {
      printf '%s\n' "$account"
      return
    }

    account=$(git config --get-urlmatch credential.username "$url" 2>/dev/null) || account=
    [[ -z $account ]] || {
      printf '%s\n' "$account"
      return
    }

    owner=$(url_owner "$url")
    if [[ -n $owner ]] && has_token "$resolved_host" "$owner"; then
      printf '%s\n' "$owner"
      return
    fi
  fi

  known=$(accounts "$resolved_host") || known=
  [[ -n $known ]] || die "no account logged in on $resolved_host; run: gh auth login --hostname $resolved_host"

  if [[ $(printf '%s\n' "$known" | wc -l) -eq 1 ]]; then
    printf '%s\n' "$known"
    return
  fi

  die "cannot tell which account this repository belongs to; name one of: $(printf '%s' "$known" | tr '\n' ' ')"
}

# git credential helper protocol: key=value lines on stdin up to a blank
# line, and the same shape back on stdout. `store` and `erase` are accepted
# and ignored, as gh's own helper does, because the tokens live in gh's
# keyring and git has nothing to add or remove.
credential_helper() {
  local op=$1 line key value
  local protocol='' cred_host='' path='' username='' cred_url=''

  case $op in
    get) ;;
    store | erase) exit 0 ;;
    *) die "--git-credential: unsupported operation '$op'" ;;
  esac

  # git splits a url= into these attributes itself before calling a helper,
  # so only the split form is read here.
  while IFS= read -r line && [[ -n $line ]]; do
    key=${line%%=*}
    value=${line#*=}
    case $key in
      protocol) protocol=$value ;;
      host) cred_host=$value ;;
      path) path=${value#/} ;;
      username) username=$value ;;
    esac
  done

  if [[ -n $path ]]; then
    cred_url=$(normalize_url "https://$cred_host/$path")
  else
    cred_url=https://$cred_host
  fi

  # Anything but https is not gh's to answer; stay silent so git moves on to
  # the next helper or the terminal.
  [[ $protocol == https && -n $cred_host ]] || exit 0

  # A username git already resolved, from credential.username or a user@host
  # remote, is an instruction rather than a hint. gh's own helper refuses a
  # username that differs from the active account; this one selects by it.
  local account=$username token
  [[ -n $account ]] || account=$(resolve_account "$cred_url" "$cred_host")

  token=$(gh_clean auth token --hostname "$cred_host" --user "$account" 2>/dev/null) || token=
  [[ -n $token ]] ||
    die "no token for account '$account' on $cred_host; logged in are: $(accounts "$cred_host" | tr '\n' ' ')"

  printf 'protocol=https\nhost=%s\nusername=%s\npassword=%s\n' "$cred_host" "$account" "$token"
}

# Point git at this script for one host. The blank helper first clears any
# helper inherited from the system config (Apple's git ships osxkeychain
# there), so a stale keychain entry cannot answer ahead of gh-as; useHttpPath
# makes git hand over the repository path the resolution depends on.
setup_git() {
  local setup_host=$1 script quoted section helper
  case $0 in
    /*) script=$0 ;;
    */*) script=$PWD/${0#./} ;;
    *) script=$(command -v -- "$0") ;;
  esac
  [[ $script == /* ]] || script=$PWD/$script
  # git runs the helper through sh -c, so the path is single-quoted with any
  # embedded quote closed, escaped and reopened. sed rather than parameter
  # expansion because bash 3.2 mangles the backslashes in that expansion.
  quoted=$(printf '%s' "$script" | sed "s/'/'\\\\''/g")
  section=credential.https://$setup_host
  helper="!'$quoted' --git-credential"

  git config --global "$section.useHttpPath" true
  git config --global --replace-all "$section.helper" ''
  git config --global --add "$section.helper" "$helper"

  printf '%s: git will now resolve credentials for %s through %s\n' "$program" "$setup_host" "$script" >&2
  printf '%s: declare accounts per URL with: git config --global gh-as.https://%s/<owner>.account <login>\n' "$program" "$setup_host" >&2
  printf '  %s.useHttpPath = %s\n' "$section" "$(git config --global --get "$section.useHttpPath")" >&2
  git config --global --get-all "$section.helper" | sed "s|^|  $section.helper = |" >&2
}

# The variable gh reads a host's token from. Match gh's host classification,
# including Enterprise Cloud with data residency. Lowercase for comparison
# without requiring bash 4's case conversion syntax.
token_var_for() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    github.com | *.github.com | github.localhost | *.github.localhost | *.ghe.com)
      printf 'GH_TOKEN\n'
      ;;
    *)
      printf 'GH_ENTERPRISE_TOKEN\n'
      ;;
  esac
}

# Runs gh with one account's token and nothing inherited.
gh_with_token() {
  local with_host=$1 with_token=$2
  shift 2
  env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
    "$(token_var_for "$with_host")=$with_token" GH_HOST="$with_host" gh "$@"
}

# Every SSH connection --setup-ssh makes shares one multiplexed session, so the
# key signs once per run instead of once per organization. An agent that asks
# for approval, as 1Password's does, would otherwise prompt fifty times, and a
# refusal partway through would read as a missing authorization.
control_dir=
control_host=
ssh_command='ssh -o BatchMode=yes'

# The directory sits directly under /tmp because a control socket path must
# fit in about a hundred bytes, which macOS's per-user temporary directory
# nearly exhausts on its own.
open_control() {
  control_host=$1
  control_dir=$(mktemp -d /tmp/gh-as.XXXXXX)
  # The master lives until close_control stops it, however long the API
  # listing between probes takes; a timed expiry would mean a second signature.
  ssh_command="ssh -o BatchMode=yes -o ControlMaster=auto -o ControlPath=$control_dir/%C -o ControlPersist=yes"
  trap close_control EXIT
}

close_control() {
  [[ -n $control_dir ]] || return 0
  # shellcheck disable=SC2086  # ssh_command is a word list by construction.
  $ssh_command -O exit "git@$control_host" >/dev/null 2>&1 </dev/null || true
  rm -f "$control_dir"/* 2>/dev/null || true
  rmdir "$control_dir" 2>/dev/null || true
  control_dir=
}

# The login GitHub greets an SSH connection with, or nothing when no key is
# accepted. `ssh -T` exits 1 even on success, so the greeting is the signal.
ssh_login() {
  local greeting
  # shellcheck disable=SC2086  # ssh_command is a word list by construction.
  greeting=$($ssh_command -T "git@$1" 2>&1 </dev/null) || true
  printf '%s\n' "$greeting" | sed -n 's/^Hi \([^!]*\)!.*/\1/p' | sed -n 1p
}

# Reads one repository over SSH. Returns 0 when git can, 1 when GitHub refuses
# the key for single sign-on, and 2 for any other failure, whose message goes
# to stderr. Only the second is evidence about authorization: an agent that
# declines to sign or a dropped connection says nothing about the organization.
#
# The refusal is recognized by GitHub's own sentence naming this organization,
# and only when nothing in the output says the key itself was rejected: a
# notice that merely mentions single sign-on, beside an agent that refused to
# sign, must not cost the organization its rule.
ssh_probe() {
  local out
  out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND=$ssh_command \
    git ls-remote "git@$1:$2/$3.git" HEAD 2>&1 >/dev/null) && return 0
  case $out in
    *"Permission denied"* | *"agent refused"* | *"signing failed"*) ;;
    *"The '$2' organization has enabled or enforced SAML SSO"*) return 1 ;;
  esac
  printf '%s\n' "$out" >&2
  return 2
}

# Judges one organization and updates its rule. Counters are setup_ssh's
# locals, which bash's dynamic scoping makes visible here.
route_org() {
  local org=$1 key=url.git@$ssh_host:$1/.insteadOf repos repo status=0

  # A failed listing must not pass for an organization with nothing to test,
  # so its status is checked before its output is read.
  if ! repos=$(gh_with_token "$ssh_host" "$token" api "orgs/$org/repos?per_page=100&type=all" \
    --hostname "$ssh_host" --paginate \
    --jq '.[] | select(.visibility != "public") | .name' 2>&1); then
    failed=$((failed + 1))
    printf 'error   %s (could not list repositories: %s)\n' "$org" "$(printf '%s' "$repos" | tr '\n' ' ')"
    return 0
  fi
  repo=$(printf '%s\n' "$repos" | sed -n 1p)
  if [[ -z $repo ]]; then
    skipped=$((skipped + 1))
    printf 'skipped %s (no non-public repository to test against)\n' "$org"
    return 0
  fi

  ssh_probe "$ssh_host" "$org" "$repo" || status=$?
  case $status in
    0)
      git config --global --replace-all "$key" "https://$ssh_host/$org/"
      routed=$((routed + 1))
      printf 'ssh     %s\n' "$org"
      ;;
    1)
      # A rule left in place for an organization the key cannot reach would
      # break git there, where HTTPS might still work while a session lasts.
      if git config --global --get-all "$key" >/dev/null 2>&1; then
        git config --global --unset-all "$key"
        removed=$((removed + 1))
      fi
      pending="$pending $org"
      printf 'https   %s (key not authorized for single sign-on)\n' "$org"
      ;;
    *)
      die "SSH to $org/$repo failed for a reason other than single sign-on (above); stopped with $org's rule unchanged. If the SSH agent asked to approve the key, approve it and rerun."
      ;;
  esac
}

# Route an account's organizations over SSH wherever its key is authorized for
# single sign-on. An OAuth token, which is what gh holds after a browser login,
# works in a SAML organization only while that organization's session lasts;
# an authorized SSH key stays authorized until it is revoked. Each organization
# is probed with git itself against a non-public repository, because a public
# one answers whether or not the key is authorized, and the API answers even
# when git over HTTPS is refused.
setup_ssh() {
  local ssh_account=$1 ssh_host=$2 token login orgs org
  local routed=0 removed=0 pending='' skipped=0 failed=0

  token=$(gh_clean auth token --hostname "$ssh_host" --user "$ssh_account" 2>/dev/null) || token=
  [[ -n $token ]] ||
    die "no token for account '$ssh_account' on $ssh_host; logged in are: $(accounts "$ssh_host" | tr '\n' ' ')"

  # Routing an organization over SSH hands its fetches to whichever account
  # owns the key, so a key belonging to someone else must stop everything.
  open_control "$ssh_host"
  login=$(ssh_login "$ssh_host")
  [[ -n $login ]] ||
    die "no SSH key is accepted by $ssh_host; add one to $ssh_account and check with: ssh -T git@$ssh_host"
  [[ $login == "$ssh_account" ]] ||
    die "the SSH key $ssh_host accepts belongs to '$login', not '$ssh_account'; pin the right key for $ssh_host in ~/.ssh/config"

  orgs=$(gh_with_token "$ssh_host" "$token" api 'user/orgs?per_page=100' \
    --hostname "$ssh_host" --paginate --jq '.[].login') ||
    die "could not list the organizations of $ssh_account on $ssh_host"

  for org in $orgs; do
    route_org "$org"
  done

  printf '%s: %d organization(s) routed over SSH, %d rule(s) removed, %d skipped, %d failed\n' \
    "$program" "$routed" "$removed" "$skipped" "$failed" >&2
  if [[ -n $pending ]]; then
    printf '%s: authorize the key for these at https://%s/settings/keys (Configure SSO), then rerun:\n ' \
      "$program" "$ssh_host" >&2
    # shellcheck disable=SC2086  # Organization logins hold no spaces; split on purpose.
    printf ' %s' $pending >&2
    printf '\n' >&2
  fi
  [[ $failed -eq 0 ]] || die "$failed organization(s) could not be checked and kept their rules; see the error lines above"
}

account=
setup=
while [[ $# -gt 0 ]]; do
  case $1 in
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l | --list)
      accounts "${host:-$default_host}"
      exit 0
      ;;
    --git-credential)
      [[ $# -eq 2 ]] || die "--git-credential takes exactly one operation (get, store or erase)"
      credential_helper "$2"
      exit 0
      ;;
    --setup-git | --setup-ssh)
      [[ -z $setup || $setup == "${1#--setup-}" ]] || die "--setup-git and --setup-ssh cannot be combined"
      setup=${1#--setup-}
      shift
      ;;
    -p | --print)
      print_only=1
      shift
      ;;
    -q | --quiet)
      quiet=1
      shift
      ;;
    --host)
      [[ $# -ge 2 ]] || die "--host needs a value"
      host=$2
      shift 2
      ;;
    --host=*)
      host=${1#*=}
      shift
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      # Only the documented <account> -- prefix belongs to us. Once the
      # command starts, leave all of its arguments untouched.
      [[ ${2:-} == -- ]] || break
      account=$1
      shift 2
      break
      ;;
  esac
done

if [[ $setup == git ]]; then
  [[ $# -eq 0 && -z $account && -z $print_only ]] || die "--setup-git takes only --host"
  setup_git "${host:-$default_host}"
  exit 0
fi

if [[ $setup == ssh ]]; then
  # The account may arrive before a `--` or as the lone remaining argument,
  # never both, and nothing else may follow it.
  [[ -z $print_only && $# -le 1 ]] || die "--setup-ssh takes at most an account and --host"
  [[ $# -eq 0 || -z $account ]] || die "more than one account given"
  [[ $# -eq 0 ]] || account=$1
  host=${host:-$default_host}
  # With no account named, only a single login is unambiguous.
  [[ -n $account ]] || account=$(resolve_account '' "$host")
  setup_ssh "$account" "$host"
  exit 0
fi

if [[ -n $print_only && -z $account && $# -eq 1 ]]; then
  account=$1
  shift
fi

url=
if remote_url=$(git remote get-url "$remote" 2>/dev/null); then
  url=$(normalize_url "$remote_url")
fi

# Off an explicit account the remote's host is not consulted: a repository
# hosted elsewhere would otherwise send the lookup to a host gh knows nothing
# about, which is only ever confusing when the account was already named.
if [[ -z $host ]]; then
  if [[ -z $account && -n $url ]]; then
    host=$(url_host "$url")
  else
    host=$default_host
  fi
fi

if [[ -z $account ]]; then
  [[ -n $url ]] || die "no '$remote' remote here; name the account explicitly (see --help)"
  account=$(resolve_account "$url" "$host")
fi

if [[ -n $print_only ]]; then
  printf '%s\n' "$account"
  exit 0
fi

[[ $# -gt 0 ]] || die "no command given (see --help)"

# `gh auth login|switch|logout` bail out with "The value of the GH_TOKEN
# environment variable is being used for authentication", so wrapping them
# would only produce a confusing failure.
if [[ ${1##*/} == gh ]]; then
  for arg in "${@:2}"; do
    case $arg in
      -*) continue ;;
      auth) die "gh auth refuses to run under an injected token; run it without $program" ;;
      *) break ;;
    esac
  done
fi

token=$(gh_clean auth token --hostname "$host" --user "$account" 2>/dev/null) || token=
[[ -n $token ]] ||
  die "no token for account '$account' on $host; logged in are: $(accounts "$host" | tr '\n' ' ')"

token_var=$(token_var_for "$host")

env_args=(-u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN)
env_args+=("$token_var=$token" "GH_AS_ACCOUNT=$account" "GH_HOST=$host")

[[ -n $quiet ]] || printf '%s: running as %s\n' "$program" "$account" >&2

# Injecting the token beats `gh auth switch`: switching rewrites
# ~/.config/gh/hosts.yml, which every shell and agent on the machine shares, so
# concurrent commands race over the active account and an interrupted one
# leaves the wrong account behind. This environment dies with the process.
exec env "${env_args[@]}" "$@"
